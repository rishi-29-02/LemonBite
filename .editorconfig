# EditorConfig for Android Kotlin Projects with JetBrains Compose support

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
continuation_indent_size = 4
max_line_length = 100

# JetBrains/IntelliJ Standard Kotlin Settings
ij_kotlin_code_style = official
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647

# --- COMPOSE SPECIFIC FORMATTING RULES ---
# Forces parameters in Composable functions to wrap cleanly when long
ij_kotlin_align_multiline_parameters = true
ij_kotlin_method_parameters_wrap = on_every_item
ij_kotlin_method_call_chain_wrap = on_every_item

# Enforces trailing commas on Composable parameters (vital for readable Compose diffs)
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# --- KTLINT / COMPOSE LINTER INTEGRATIONS ---
ktlint_code_style = android_studio
ktlint_standard_max_line_length = 100
ktlint_standard_no-wildcard-imports = enabled
ktlint_standard_trailing-comma-on-call-site = enabled
ktlint_standard_trailing-comma-on-declaration-site = enabled

# Allows Compose functions to begin with an Uppercase letter (ignores standard camelCase rule)
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.xml]
indent_style = space
indent_size = 4
max_line_length = 100
